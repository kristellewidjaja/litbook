{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },

    { "name": "debug",   "displayName": "Debug (GCC)",       "inherits": ["base", "gcc"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "displayName": "Release -O3 (GCC)", "inherits": ["base", "gcc"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "asan",    "displayName": "ASan + UBSan (GCC)", "inherits": ["base", "gcc"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "LITBOOK_SANITIZER": "address,undefined" } },
    { "name": "tsan",    "displayName": "TSan (GCC)",        "inherits": ["base", "gcc"],
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "LITBOOK_SANITIZER": "thread" } },

    { "name": "debug-clang",   "displayName": "Debug (Clang)",        "inherits": ["clang", "debug"] },
    { "name": "release-clang", "displayName": "Release -O3 (Clang)",  "inherits": ["clang", "release"] },
    { "name": "asan-clang",    "displayName": "ASan + UBSan (Clang)", "inherits": ["clang", "asan"] },
    { "name": "tsan-clang",    "displayName": "TSan (Clang)",         "inherits": ["clang", "tsan"] },

    { "name": "profile", "displayName": "Release -O3 with symbols and frame pointers, for perf (GCC)",
      "inherits": ["base", "gcc"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-g -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer"
      } },

    { "name": "fuzz", "displayName": "libFuzzer + ASan + UBSan (Clang)", "inherits": ["base", "clang"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g",
        "LITBOOK_SANITIZER": "address,undefined",
        "LITBOOK_FUZZ": "ON",
        "LITBOOK_BUILD_TESTS": "OFF",
        "LITBOOK_BUILD_BENCH": "OFF"
      } }
  ],
  "buildPresets": [
    { "name": "debug",         "configurePreset": "debug" },
    { "name": "release",       "configurePreset": "release" },
    { "name": "asan",          "configurePreset": "asan" },
    { "name": "tsan",          "configurePreset": "tsan" },
    { "name": "debug-clang",   "configurePreset": "debug-clang" },
    { "name": "release-clang", "configurePreset": "release-clang" },
    { "name": "asan-clang",    "configurePreset": "asan-clang" },
    { "name": "tsan-clang",    "configurePreset": "tsan-clang" },
    { "name": "profile",       "configurePreset": "profile" },
    { "name": "fuzz",          "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false },
      "filter": { "exclude": { "label": "exercise" } }
    },
    {
      "name": "exercises",
      "displayName": "Local practice exercises only",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "filter": { "include": { "label": "exercise" } }
    },
    {
      "name": "asan-env",
      "hidden": true,
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1:strict_string_checks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan-env",
      "hidden": true,
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1" }
    },
    { "name": "debug",         "configurePreset": "debug",         "inherits": ["test-base"] },
    { "name": "release",       "configurePreset": "release",       "inherits": ["test-base"] },
    { "name": "asan",          "configurePreset": "asan",          "inherits": ["test-base", "asan-env"] },
    { "name": "tsan",          "configurePreset": "tsan",          "inherits": ["test-base", "tsan-env"] },
    { "name": "debug-clang",   "configurePreset": "debug-clang",   "inherits": ["test-base"] },
    { "name": "release-clang", "configurePreset": "release-clang", "inherits": ["test-base"] },
    { "name": "asan-clang",    "configurePreset": "asan-clang",    "inherits": ["test-base", "asan-env"] },
    { "name": "tsan-clang",    "configurePreset": "tsan-clang",    "inherits": ["test-base", "tsan-env"] }
  ]
}
