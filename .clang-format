---
Language: Cpp
BasedOnStyle: Google
IndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
IncludeBlocks: Regroup
IncludeCategories:
  # 1: the project's own headers
  - Regex: '^"litbook/'
    Priority: 1
  # 2: third-party libraries (gtest, benchmark, pybind11)
  - Regex: '^<(gtest|gmock|benchmark|pybind11)/'
    Priority: 2
  # 3: system / POSIX headers
  - Regex: '^<(sys|netinet|arpa)/|^<[a-z_]+\.h>'
    Priority: 3
  # 4: C++ standard library
  - Regex: '^<[a-z_]+>'
    Priority: 4
...
